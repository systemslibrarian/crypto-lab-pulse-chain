{
  "name": "crypto-lab-pulse-chain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Verify two deployed randomness beacons end to end: NIST Beacon 2.0 pulses (SHA-512 hash chain, skiplist, RSA signature, precommitment) and drand League of Entropy rounds (threshold BLS on BLS12-381).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "mutate": "node scripts/mutate.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
